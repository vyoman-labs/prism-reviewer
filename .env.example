# Prism Reviewer Environment Configuration
# Copy this file to '.env' and fill in your values for local execution.

# GitHub Personal Access Token (PAT) for fetching pull requests and publishing review comments
GITHUB_TOKEN=ghp_your_github_token_here

# LLM Provider API Key (OpenAI, Anthropic, LiteLLM proxy, etc.)
LLM_PROVIDER_API_KEY=sk-your_llm_api_key_here

# LLM Model Name override (e.g. gpt-4o, claude-3-5-sonnet-20241022, gemini-1.5-pro, etc.)
LLM_MODEL_OVERRIDE=openai/gpt-4o

# Optional: Concurrency & Rate Limits
# MAX_REQUESTS_PER_MINUTE=60
# MAX_CONCURRENT_REQUESTS=10
# RETRIES=3
# BACKOFF_SECONDS=2
